name: Daten aktualisieren

on:
  schedule:
    - cron: "17 3 * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Spiele aus der Riot-API holen
        env:
          RIOT_API_KEY: ${{ secrets.RIOT_API_KEY }}
        run: python update.py
      - name: Ergebnis speichern
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@users.noreply.github.com"
          git add mine.json matches.json
          git diff --cached --quiet || git commit -m "Daten aktualisiert"
          git push
